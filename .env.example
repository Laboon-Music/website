# Copy this file to .env.local and fill in the values (never commit .env.local).
# Without Brevo values, forms run in "dry run" locally (logged in the terminal).
# Details: docs/deployment.md

# Brevo API key (Settings > SMTP & API > API Keys) — docs/integrations/brevo.md
BREVO_API_KEY=

# Brevo list ids (Contacts > Lists). Prod: 5 / 6 — staging: 7 / 8.
BREVO_LIST_ID_LAUNCH=
BREVO_LIST_ID_BETA=

# Brevo "double opt-in" template id (confirmation email). The number is in the
# template edit URL (/templates/email/edit/<id>). Currently 1.
BREVO_DOI_TEMPLATE_ID=

# Inbox receiving the contact form messages (/contact). Sent through Brevo
# (same BREVO_API_KEY); "Reply" answers the visitor directly.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile — invisible anti-bot for the forms (docs/features/antibot.md).
# Cloudflare > Turnstile > Add widget. Set BOTH or neither (then only the
# honeypot and the minimum delay protect the forms).
# Public test keys (always pass) for local use:
#   1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Laboon API — required by /reset-password and /confirm-email
# (docs/features/account-links.md). Base URL including /v1, one per environment:
#   - prod    -> https://api.laboon-app.com/v1
#   - staging -> https://api-staging.laboon-app.com/v1
#   - local   -> http://localhost:3333/v1
# The site's origin must be listed in the API's CORS_ORIGINS. Public value.
NEXT_PUBLIC_API_URL=

# Staging only: the staging API is closed to the public and requires the header
# X-Laboon-Staging (value in the team password manager, see infra docs/cloudflare.md).
# Leave empty in production. The value ships in the browser bundle (not a secret).
NEXT_PUBLIC_API_STAGING_HEADER=

# Sentry — error alerts (docs/features/monitoring.md). Optional: without it,
# errors are only written to the Vercel logs.
SENTRY_DSN=
